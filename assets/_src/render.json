   "body": "<div class=\"grid-bg\"></div>\n<div style=\"position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;padding:54px 50px;gap:34px\">\n  <div style=\"display:flex;flex-direction:column;align-items:center;gap:12px\">\n    <div class=\"accent\" style=\"font-size:22px;font-weight:700;letter-spacing:.18em\">ONE CODEBASE → MANY BRANDS</div>\n    <div class=\"title\" style=\"font-size:52px\">One Flutter engine, re-skinned per client</div>\n  </div>\n  <div style=\"display:flex;gap:30px;align-items:flex-start\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:26px\">\n      <div style=\"filter:drop-shadow(0 0 40px #FD7E1555)\"><div class=\"iphone\" style=\"--w:250px\"><div class=\"scr\"><div class=\"island\"></div><img src=\"file:///D:/shaker-github/_store/ios_com.devora.alife/ios_shot_04.png\"></div></div></div>\n      <div style=\"display:flex;align-items:center;gap:14px;width:330px;padding:14px 16px;border-radius:20px;background:#ffffff0d;border:1px solid #ffffff1f;border-top:4px solid #FD7E15\">\n        <img src=\"file:///D:/shaker-github/_store/com.devora.alife/icon.png\" style=\"width:58px;height:58px;border-radius:14px;background:#fff\">\n        <div style=\"display:flex;flex-direction:column;gap:3px;min-width:0\">\n          <div style=\"font-family:'Readex Pro',Inter;font-weight:700;font-size:20px;white-space:nowrap\">Aleefie · أليفي</div>\n          <div style=\"font-size:15px;opacity:.75\">Pet supplies · Play + App Store</div>\n          <div style=\"font-family:Consolas,monospace;font-size:13px;opacity:.6\">com.devora.alife</div>\n        </div></div></div><div style=\"display:flex;flex-direction:column;align-items:center;gap:26px\">\n      <div style=\"filter:drop-shadow(0 0 40px #7CB34255)\"><div class=\"android\" style=\"--w:250px\"><div class=\"scr\"><div class=\"cam\"></div><img src=\"file:///D:/shaker-github/_store/com.devora.dinotoys/screen_02.png\"></div></div></div>\n      <div style=\"display:fle