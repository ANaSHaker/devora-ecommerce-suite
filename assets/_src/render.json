\"iphone\" style=\"--w:250px\"><div class=\"scr\"><div class=\"island\"></div><img src=\"file:///D:/shaker-github/_store/com.irtaah.devora/shot_01.png\"></div></div></div>\n      <div style=\"display:flex;align-items:center;gap:14px;width:330px;padding:14px 16px;border-radius:20px;background:#ffffff0d;border:1px solid #ffffff1f;border-top:4px solid #2E7D32\">\n        <img src=\"file:///D:/shaker-github/_store/com.irtaah.devora/icon.png\" style=\"width:58px;height:58px;border-radius:14px;background:#fff\">\n        <div style=\"display:flex;flex-direction:column;gap:3px;min-width:0\">\n          <div style=\"font-family:'Readex Pro',Inter;font-weight:700;font-size:20px;white-space:nowrap\">Irtaah · ارتاح</div>\n          <div style=\"font-size:15px;opacity:.75\">Home services · Google Play</div>\n          <div style=\"font-family:Consolas,monospace;font-size:13px;opacity:.6\">com.irtaah.devora</div>\n        </div></div></div></div>\n  <div style=\"display:flex;align-items:center;gap:16px;font-size:19px;opacity:.9;padding:12px 22px;border-radius:99px;background:#ffffff0d;border:1px solid #ffffff1f\">\n    <span>Also white-labelled for</span><img src=\"file:///D:/shaker-github/repos/devora-ecommerce-suite/assets/_src/logo_pets_with_admin.png\" style=\"height:52px;width:52px;object-fit:contain;border-radius:12px;background:#fff;padding:4px\"><img src=\"file:///D:/shaker-github/repos/devora-ecommerce-suite/assets/_src/logo_gorcery_with_admin.png\" style=\"height:52px;width:52px;object-fit:contain;border-radius:12px;background:#fff;padding:4px\"><img src=\"file:///D:/shaker-github/repos/devora-ecommerce-suite/assets/_src/logo_okaView.png\" style=\"height:52px;width:52px;object-fit:contain;border-radius:12px;background:#fff;padding:4px\"><img src=\"file:///D:/shaker-github/repos/devora-ecommerce-suite/assets/_src/logo_ElWaseq.png\" style=\"height:52px;width:52px;object-fit:contain;border-radius:12px;background:#fff;padding:4px\"><span>+ a shared store-owner admin app</s